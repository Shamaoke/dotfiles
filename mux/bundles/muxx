#! /usr/bin/env zsh

function main TRAPEXIT {

  cd $DATA_DIR/pm
  mux start --detached --name=organizer organizer

  cd $DATA_DIR/artifacts
  mux start --detached --name=notes notes

  cd $HOME/.dotfiles
  mux start --detached --name=dotfiles generic

  cd $HOME/.lingo
  mux start --detached --name=lingo lingo

  cd $HOME/.workspace/summaries
  mux start --detached --name=summaries generic

  cd $HOME/.workspace/tem18lng-soft/tem18lng-display/source
  mux start --detached --name=tem18lng-display generic

  cd $HOME/.workspace/tem18lng-soft/tem18lng-rack/source
  mux start --detached --name=tem18lng-rack generic

  cd $HOME/.workspace/playground/rust/learn_rust
  mux start --detached --name=pg-rust generic

  cd $HOME/.workspace/playground/cpp/learn_cpp
  mux start --detached --name=pg-cpp generic

  cd $HOME/.workspace/playground/c/learn_c
  mux start --detached --name=pg-c generic

  cd $HOME/.workspace/playground/qt/learn_qt
  mux start --detached --name=pg-qt generic

  cd $HOME/.workspace/playground/copilot
  mux start --detached --name=pg-copilot generic

  cd $HOME/.desktop
  mux start --detached --name=desktop console

  tmux attach-session -t desktop
}

