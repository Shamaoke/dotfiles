#! /usr/bin/env zsh

declare session_name=$1
declare session_state=$2

## Using the `=` prefix for a session name forces an exact match, preventing
## prefix matching (which occurs in tmux by default), so, for example, `=my_sess`
## will only match exactly `my_sess`, not `my_session`.
tmux has-session -t=$session_name 2>/dev/null

if [[ $? -ne 0 ]] {

  ## Create a new session with the initial window
  tmux new-session -d -s $session_name -n calcurse

  ## Create the session's windows
  tmux new-window    -t $session_name:2 -n mail

  tmux new-window    -t $session_name:3 -n tasks
  tmux split-window  -t $session_name:3
  tmux split-window  -t $session_name:3
  tmux split-window  -t $session_name:3
  tmux select-layout -t $session_name:3 'cb19,158x33,0,0{79x33,0,0[79x16,0,0,122,79x16,0,17,125],78x33,80,0[78x16,80,0,123,78x16,80,17,124]}'

  cd $DATA_DIR/accounts
  tmux new-window -t $session_name:4 -n accounts

  cd $DATA_DIR/pm
  tmux new-window -t $session_name:5 -n pm

  cd $DATA_DIR/accounts
  tmux new-window    -t $session_name:6 -n git-accounts
  tmux split-window  -t $session_name:6
  tmux split-window  -t $session_name:6
  tmux select-layout -t $session_name:6 '5fe9,158x33,0,0{79x33,0,0,4,78x33,80,0[78x16,80,0,5,78x16,80,17,6]}'

  cd $DATA_DIR/pm
  tmux new-window    -t $session_name:7 -n git-pm
  tmux split-window  -t $session_name:7
  tmux split-window  -t $session_name:7
  tmux select-layout -t $session_name:7 '22ed,158x33,0,0{79x33,0,0,7,78x33,80,0[78x16,80,0,8,78x16,80,17,9]}'

  tmux new-window -t $session_name:8 -n fm

  ## Window “calcurse”
  tmux send-keys -t $session_name:1 "calcurse --confdir '$DATA_DIR/calcurse/config' --datadir '$DATA_DIR/calcurse/data'" C-m

  ## Window “mutt”
  tmux send-keys -t $session_name:2 mutt C-m

  ## Window “tasks”
  tmux send-keys   -t $session_name:3.1 "hwatch 'task -ACTIVE long'" C-m
  tmux send-keys   -t $session_name:3.2 "hwatch 'task completed'" C-m
  tmux send-keys   -t $session_name:3.3 "hwatch 'task +ACTIVE long'" C-m
  tmux select-pane -t $session_name:3.4

  ## Window “accounts”
  tmux send-keys -t $session_name:4 vim C-m

  ## Window “pm”
  tmux send-keys -t $session_name:5 'vim -p goals.md activities.md time.md books.md soft.md' C-m

  ## Window “git-accounts”
  tmux send-keys   -t $session_name:6.1 "hwatch 'git mylog'" C-m
  tmux send-keys   -t $session_name:6.2 "hwatch 'git st'" C-m
  tmux select-pane -t $session_name:6.3

  ## Window “git-pm”
  tmux send-keys   -t $session_name:7.1 "hwatch 'git mylog'" C-m
  tmux send-keys   -t $session_name:7.2 "hwatch 'git st'" C-m
  tmux select-pane -t $session_name:7.3

  ## Window “fm”
  tmux send-keys -t $session_name:8 vifm C-m

  ## Select the initial window and pane
  tmux select-window -t $session_name:1
  tmux select-pane   -t $session_name:1.1

  ## Attach the session
  [[ $session_state == 'attached' ]] && tmux attach-session -t $session_name

  return 0

} else {

  ## Attach the session
  [[ $session_state == 'attached' ]] && tmux attach-session -t $session_name

  return 0
}

