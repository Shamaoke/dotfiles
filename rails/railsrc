#
# --skip-action-cable   -- intergartion websockets into Rails
# --skip-action-mailbox -- integration of email inbox behaviour into Rails controllers
# --skip-action-mailer  -- send email with Rails
# --skip-action-text    -- add the ability to put a HTML into Rails
# --skip-bootsnap       -- boot a Rails app faster
# --skip-hotwire        -- disable Hotwire integration
# --skip-jbuilder       -- build JSON response
# --skip-kamal          -- skip Kamal setup
# --skip-solid          -- skip Solid Cache, Queue, and Cable setup
# --skip-system-tests   -- functional testing abilities
# --skip-test           -- unit testing abilities
#

## Preconfigure for selected database
## Default: sqlite3
## Possible values: mysql, trilogy, postgresql, sqlite3, mariadb-mysql, mariadb-trilogy
--database sqlite3

## Choose JavaScript approach
## Default: importmap
## Possible values: importmap, bun, webpack, esbuild, rollup
--javascript importmap

## Choose CSS processor. Check https://github.com/rails/cssbundling-rails for more options
## Possible values: tailwind, bootstrap, bulma, postcss, sass
--css tailwind

## Skip Brakeman setup
--skip-brakeman
## Brakeman is a free vulnerability scanner specifically designed for Ruby on
## Rails applications. It statically analyzes Rails application code to find
## security issues at any stage of development.
##
## [Brakeman](https://brakemanscanner.org)
