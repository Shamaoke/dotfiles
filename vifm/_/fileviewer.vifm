
""
"" ::: Set command for previewing files :::
""

fileviewer */ eza --color=always --tree %c
fileviewer <text/*,application/*> /usr/bin/bat --color=always --terminal-width=100 --wrap=never --paging=never %c
fileviewer * /usr/bin/hexyl %c

