[core]
  editor = vim
  quotepath = false
[alias]
  mylog   = log --graph --date=format:'%d.%m.%Y %H:%M' --pretty=format:'%C(yellow)%<(7)%h %C(brightgreen)%<(12,mtrunc)%an %C(brightblue)%<(16)%ad%C(auto)%d %C(brightwhite)%s'
  godalog = log --graph --oneline --decorate=short --all
  godlog  = log --graph --oneline --decorate=short
  merge = merge --ff-only
  st = !git branch && echo && git status --short --untracked-files=all && echo && git diff --stat
  stl = stash list --pretty=format:'%C(red)%gd %C(blue)%cr %C(brightwhite)%s'
[merge]
  tool = vimdiff
[color]
  ui = always
[push]
  default = matching
[commit]
  verbose = true
[init]
  defaultBranch = main
[diff]
  tool = vimdiff
[difftool]
  prompt = false

